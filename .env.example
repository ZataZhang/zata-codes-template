# =============================================================================
# Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control - it contains secrets!
#
# Configuration Priority (highest to lowest):
# 1. Environment variables
# 2. .env / .env.local files
# 3. config.toml
# 4. Code defaults
# =============================================================================

# =============================================================================
# Application Settings
# =============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# =============================================================================
# Redis (会话存储)
# =============================================================================
# 双认证域的会话持久化依赖 Redis（public / admin 按 key 前缀隔离命名空间）。
# 本地可启动 docker-compose.testing.yml 的 redis（带密码）：
#   REDIS_URL=redis://:redis123@localhost:6379/0
# 或指向任意外部 / 无密码本地 Redis：
REDIS_URL=

# =============================================================================
# Auth (双认证域)
# =============================================================================
# 初始管理员种子（admin 域）：后端启动时按用户名幂等创建；明文密码仅用于首次
# 创建，库中只保存 bcrypt 哈希。两项任一为空则跳过种子。请在 .env.local 覆盖。
# AUTH_ADMIN_BOOTSTRAP_USERNAME=admin
AUTH_ADMIN_BOOTSTRAP_PASSWORD=

# 初始 public 用户种子（用于本地开发 / E2E）：后端启动时按邮箱幂等创建；任一为空
# 则跳过种子。请在 .env.local 覆盖。
# APP_BOOTSTRAP_EMAIL=user@example.com
APP_BOOTSTRAP_PASSWORD=

# =============================================================================
# Database Credentials
# =============================================================================
# Complete database URL. Overrides config.toml defaults.
#
# PostgreSQL (recommended for production / team development):
#   Format: postgresql+psycopg2://user:password@host:port/database
DATABASE_URL=
#
# MySQL:
#   Format: mysql+pymysql://user:password@host:port/database
#
# SQLite (local quick-start, no PostgreSQL required):
#   1. Set DATABASE_URL to a local file path, e.g. sqlite:///./dev.db
#   2. Run: DATABASE_URL=sqlite:///./dev.db uv run alembic upgrade head
#   3. Start services: DATABASE_URL=sqlite:///./dev.db just run
#DATABASE_URL=sqlite:///./dev.db

# =============================================================================
# AI Model (主模型)
# =============================================================================
# 只有需要调用大模型的项目才填。任意 OpenAI 兼容端点的 URL、API Key 和模型名，
# 由 settings.py 的 load_primary_model_settings() 读取；模板本身不内置 LLM 客户端，
# 派生项目拿到这三个值后自行接 ChatOpenAI / openai SDK / 其他兼容客户端。
#
# 三项必须同时填写或同时留空；只填一部分会抛 PrimaryModelConfigError。
#
# - MODEL_BASE_URL：OpenAI 协议端点，通常以 /v1 结尾
# - MODEL_API_KEY：端点密钥；无需鉴权的本地端点（Ollama / vLLM）也要填占位值
# - MODEL_NAME：原样作为端点侧的 model id 发送，自带斜杠的写法（如
#   anthropic/claude-3.5-sonnet）同样可用

MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# =============================================================================
# Sandbox — E2B Embed (local) or E2B compatible cloud control plane
# =============================================================================
# config.toml 注册 E2B 环境变量别名；本地运行 `cd ../zata-ops && just e2b-embed up
# ../zata_code_template/.env.local` 可启动官方 E2B Embed 并自动写入下列本地配置。
# E2B_API_KEY 是密钥；它可以是本地 Embed team key 或兼容云端服务的 API key。
#
# 未启用 E2B 时密钥留空不会影响应用启动；启用后若缺失，沙箱后端不会注册。
E2B_API_KEY=
# `just e2b-embed up` 会将这些值写入 .env.local；云端可配置为其控制面与模板地址。
# SANDBOX_AGENT_PROVIDER=e2b
# E2B_API_URL=
# E2B_SANDBOX_URL=
# E2B_TEMPLATE_ID=
# 云端自建模板脚本（deploy/sandbox/build_e2b_template.sh）另需以下变量：
# E2B_DOMAIN=
# 模板构建先把 linux/amd64 OCI 镜像推送到同账号同地域的仓库，再交给云平台构建。
# 镜像必须带唯一 tag；仓库用户名非密钥。
# E2B_TEMPLATE_IMAGE=
# E2B_REGISTRY_USERNAME=
# 仓库凭据属于密钥，且仅构建期使用（不进后端容器），因此保持注释状态，只写入
# 本地 .env / .env.local。
# E2B_REGISTRY_PASSWORD=
# E2B_TEMPLATE_CPU_COUNT=2
# E2B_TEMPLATE_MEMORY_MB=2048

# =============================================================================
# Run Tracing / OTLP export (OPTIONAL)
# =============================================================================
# Run 执行轨迹的可选外部导出。留空则不装配 exporter，本地 admin 诊断页完全可用；
# 两个变量都属于「可能携带凭据的 URL」，因此保留未注释的空值。
#
# - OTEL_EXPORTER_OTLP_TRACES_ENDPOINT：完整的 Trace URL，原样使用，SDK 不追加
#   signal 路径。阿里云 ARMS 等厂商给的接入地址填这里。
# - OTEL_EXPORTER_OTLP_ENDPOINT：通用基础地址，仅在 traces 专用变量未设置时生效；
#   若其已指向 .../traces 则原样使用，否则自动补 /v1/traces。
#
# 导出是 best-effort：超时、被拒绝或关停 flush 失败都不回滚事件、不改变 Run 终态。
# 装配还需要安装可选依赖：uv sync --extra tracing

OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_ENDPOINT=

# =============================================================================
# Frontend Settings (OPTIONAL)
# =============================================================================
# Public frontend base URL for backend API calls.
# Optional: docker-compose.yml defaults to its internal backend service URL.
# Only override this if the backend service name or port differs.
# API_BASE_URL=http://zata-codes-template-backend:8000

# =============================================================================
# Operations Toolkit (zata-ops)
# =============================================================================
# Database backup/restore, S3 diagnostics, VPS provisioning, log inspection
# and the terminal dashboard have moved to the standalone `zata-ops` CLI.
#
# Install once:
#   cd /path/to/zata-ops && uv tool install --force .
#
# Backup/storage settings now belong to `zata-ops`, not the application
# container. Keep those values in the environment used to run `zata-ops`
# (for example `.env.local` or a scheduled job env). zata-ops loads `.env`
# then `.env.local` automatically; see zata-ops/docs/getting-started.md for
# the full key list.


# =============================================================================
# S3-compatible Object Storage (MinIO)
# =============================================================================
# 对应 docker-compose.testing.yml -> minio 服务
# API:     http://localhost:9000
# Console: http://localhost:9001  (minioadmin / minioadmin)
# 注意：首次启动后需在 Console 手动创建 bucket `app-assets`
# 这些键仅在使用 docker-compose.testing.yml 启动 MinIO 时需要；本地主应用
# (docker-compose.yml) 不引用，保持注释状态以避免被误识别为主应用必填项。
# 如需启用，请取消注释并按需调整 endpoint / 凭据 / bucket / prefix。
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=app-assets
# S3_PREFIX=app-assets
# Addressing style: path (MinIO, default), virtual (Alibaba OSS / Tencent COS), auto (AWS S3).
# S3_ADDRESSING_STYLE=path
