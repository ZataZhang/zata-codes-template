# =============================================================================
# Dokploy Deployment Environment Variables
# =============================================================================
# Copy / rename this file and fill in your production secrets.
# In Dokploy: Project -> Service -> "Environment" tab -> paste key=value pairs.
# Dokploy writes those values to a `.env` file in the same directory as
# `docker-compose.dokploy.yml`; the backend service loads that whole file via
# `env_file`, so a key added here (or in the panel) reaches the container
# without also editing the compose `environment` allowlist.
# Keep this file as a template; DO NOT expect compose to read it by that name.
#
# DO NOT commit real values to git.
# =============================================================================

# =============================================================================
# 1. Dokploy / Traefik (REQUIRED)
# =============================================================================
# Public domain that Traefik will route to the frontend service.
# Example: app.example.com
DOMAIN=

# =============================================================================
# 2. Database (REQUIRED)
# =============================================================================
# Full PostgreSQL connection string. Overrides config.toml defaults.
# Format: postgresql+psycopg2://user:password@host:port/database
DATABASE_URL=

# =============================================================================
# 3. AI Model (主模型, 按需)
# =============================================================================
# 只有需要调用大模型的项目才填。任意 OpenAI 兼容端点的 URL、API Key 和模型名，
# 由 settings.py 的 load_primary_model_settings() 读取。
# 三项必须同时填写或同时留空；只填一部分会抛 PrimaryModelConfigError。
# MODEL_NAME 原样作为端点侧的 model id 发送，自带斜杠的写法（如
# anthropic/claude-3.5-sonnet）同样可用。

MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# =============================================================================
# 3b. Sandbox — Cloud Sandbox Control Plane Credentials (按需)
# =============================================================================
# 仅在启用云沙箱档（config.toml 的 [sandbox_agent] provider = "e2b"）时需要；
# 由后端容器读取。未启用时留空即可。仓库凭据等构建期专用变量不在此声明，见
# .env.example 与 docs/guides/sandbox-runtime.md。
E2B_API_KEY=

# =============================================================================
# 3c. Run Tracing / OTLP export (OPTIONAL)
# =============================================================================
# Run 执行轨迹的可选外部导出。留空则不装配 exporter，本地 admin 诊断页完全可用。
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT 是完整 Trace URL，原样使用；
# OTEL_EXPORTER_OTLP_ENDPOINT 是通用基础地址（已含 /traces 则原样，否则补 /v1/traces），
# 仅在 traces 专用变量未设置时生效。装配还需安装可选依赖：uv sync --extra tracing。

OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_ENDPOINT=

# =============================================================================
# 4. Authentication (REQUIRED)
# =============================================================================
# 初始管理员种子（admin 域）：后端启动时按用户名幂等创建；明文密码仅用于首次创建，
# 库中只保存 bcrypt 哈希。两项任一为空则跳过种子。
AUTH_ADMIN_BOOTSTRAP_USERNAME=admin
AUTH_ADMIN_BOOTSTRAP_PASSWORD=

# 初始 public 用户种子仅用于本地开发 / E2E，生产环境公开用户自行注册，无需配置；
# 后端在邮箱或密码为空时跳过种子。此处列出仅为与 docker-compose.dokploy.yml 的
# 环境变量声明保持一致。
# APP_BOOTSTRAP_EMAIL=user@example.com
# APP_BOOTSTRAP_PASSWORD=

# =============================================================================
# 4b. Redis (会话存储, REQUIRED)
# =============================================================================
# 双认证域会话持久化（public / admin 按 key 前缀隔离）。生产指向托管 Redis。
# Format: redis://[:password@]host:port/db
REDIS_URL=

# =============================================================================
# 5. Operations Toolkit (zata-ops)
# =============================================================================
# Backups, S3 diagnostics, VPS provisioning, and log inspection are now the
# job of the standalone `zata-ops` CLI. Schedule `zata-ops db backup` as a
# Dokploy Scheduled Job (or via systemd / cron / GitHub Actions) with the
# matching S3_* environment variables. The application service no longer
# needs to know about backup storage.

# =============================================================================
# 6. Optional Overrides
# =============================================================================
# API edge limits (defaults: public 120/min, admin 60/min; 1 MiB body limit).
# PUBLIC_API_RATE_LIMIT_AVERAGE=120
# PUBLIC_API_RATE_LIMIT_PERIOD=1m
# PUBLIC_API_RATE_LIMIT_BURST=60
# PUBLIC_API_MAX_INFLIGHT=40
# PUBLIC_API_MAX_BODY_BYTES=1048576
# ADMIN_API_RATE_LIMIT_AVERAGE=60
# ADMIN_API_RATE_LIMIT_PERIOD=1m
# ADMIN_API_RATE_LIMIT_BURST=20
# ADMIN_API_MAX_INFLIGHT=20
# ADMIN_API_MAX_BODY_BYTES=1048576
#
# Security features default to enabled/secure in the production Compose file.
# AUTH_COOKIE_SECURE=true
# SECURITY_RATE_LIMIT_ENABLED=true
# OBSERVABILITY_METRICS_ENABLED=false
# MCP_ENABLED=false
# Leave this at 0 for direct clients; set a depth only after configuring
# Traefik forwardedHeaders.trustedIPs for a CDN/load balancer in front.
# TRAEFIK_CLIENT_IP_DEPTH=0
# FORWARDED_ALLOW_IPS defaults to * inside the private backend-app network.
# Narrow it when possible; never connect untrusted containers to that network.
# FORWARDED_ALLOW_IPS=*

# Public frontend base URL for backend API calls.
# Optional: docker-compose.dokploy.yml defaults to http://zata-codes-template-backend:8000.
# Only override if your backend service name differs from the compose default.
API_BASE_URL=http://zata-codes-template-backend:8000

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO
