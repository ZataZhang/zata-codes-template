# FC Sandbox 自定义执行镜像。构建与发布见 build_e2b_template.sh。
# Node 官方镜像自带 uid/gid 1000；envd 注入的 user 因此使用 uid/gid 1001。
FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        coreutils \
        curl \
        libcap2-bin \
        python3 \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}" \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/home/node

# envd 使用 login shell，不能只依赖 ENV PATH；稳定入口放到 /usr/local/bin。
RUN printf '%s\n' '#!/bin/sh' 'exec /opt/venv/bin/python3 "$@"' \
        > /usr/local/bin/python3 \
    && printf '%s\n' '#!/bin/sh' 'exec /opt/venv/bin/python3 "$@"' \
        > /usr/local/bin/python \
    && printf '%s\n' '#!/bin/sh' 'exec /opt/venv/bin/pip3 "$@"' \
        > /usr/local/bin/pip3 \
    && chmod +x /usr/local/bin/python /usr/local/bin/python3 /usr/local/bin/pip3

RUN python -m pip install --no-cache-dir \
        numpy==2.1.3 \
        openpyxl==3.1.5 \
        pandas==2.2.3 \
        python-dateutil==2.9.0.post0 \
        scipy==1.14.1 \
    && python -c "import openpyxl,pandas,numpy,scipy" \
    && node --version

RUN mkdir -p /workspace/inputs /workspace/outputs /assets /tmp/agent \
        /large_tool_results /conversation_history /home/node \
    && python -m pip freeze > /assets/baseline-packages.txt \
    && chown -R 1001:1001 /workspace /assets /tmp/agent /home/node \
        /large_tool_results /conversation_history \
    && chmod 0666 /etc/passwd /etc/group

WORKDIR /workspace
CMD ["/bin/bash"]
