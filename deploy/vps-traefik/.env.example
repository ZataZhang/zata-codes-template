# /opt/apps/zata-codes-template/.env
# Deployment metadata. The *_IMAGE lines may be rewritten by the optional
# GitHub Actions deploy workflow on every release. Runtime secrets live in
# app.env and should never be touched by CD.

# Public hostname. DNS must already resolve to this server, and ports 80/443
# must be open.
DOMAIN=app.example.com

# Optional API origin override. By default the Compose project-specific backend
# network alias is used; set this only when the public frontend uses another API.
# API_BASE_URL=https://api.example.com

# External Docker network used by the host-level Traefik gateway.
TRAEFIK_NETWORK=traefik

# Leave at 0 when clients connect directly to Traefik. If a CDN/load balancer
# sits in front, configure Traefik forwardedHeaders.trustedIPs first, then set
# this to the correct position in its sanitized X-Forwarded-For chain.
TRAEFIK_CLIENT_IP_DEPTH=0

# HTTPS-only authentication cookies. Keep true for production; only change for
# a local HTTP setup. Request limits and other app settings belong in app.env.
AUTH_COOKIE_SECURE=true

# API ingress defaults. Tune against real traffic and application capacity.
PUBLIC_API_RATE_LIMIT_AVERAGE=120
PUBLIC_API_RATE_LIMIT_PERIOD=1m
PUBLIC_API_RATE_LIMIT_BURST=60
PUBLIC_API_MAX_INFLIGHT=40
PUBLIC_API_MAX_BODY_BYTES=1048576
ADMIN_API_RATE_LIMIT_AVERAGE=60
ADMIN_API_RATE_LIMIT_PERIOD=1m
ADMIN_API_RATE_LIMIT_BURST=20
ADMIN_API_MAX_INFLIGHT=20
ADMIN_API_MAX_BODY_BYTES=1048576

# Container images. Replace the host, namespace, and tags for your registry.
# The deploy workflow rewrites these on every release; only the BACKEND_IMAGE,
# ADMIN_IMAGE and PUBLIC_IMAGE placeholders are needed for a manual first-time bring-up.
BACKEND_IMAGE=registry.example.com/your-namespace/zata-codes-template-backend:initial
ADMIN_IMAGE=registry.example.com/your-namespace/zata-codes-template-admin:initial
PUBLIC_IMAGE=registry.example.com/your-namespace/zata-codes-template-public:initial

# Backups, S3 diagnostics, and VPS provisioning have moved to the standalone
# `zata-ops` CLI; the template no longer ships a backup service profile or
# image. Install zata-ops once and call it from a systemd timer / cron /
# GitHub Actions schedule. See zata-ops/docs/guides/scheduling.md.
