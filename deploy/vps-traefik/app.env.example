# /opt/apps/zata-codes-template/app.env
# Runtime configuration and secrets. This file exists only on the server.
# Never commit a filled copy.

# PostgreSQL connection string.
# Format: postgresql+psycopg2://user:password@host:port/database
DATABASE_URL=

# JWT signing secret. bootstrap.sh fills this when creating app.env.
# Manual generation:
#   openssl rand -hex 32
API_SECRET_KEY=

# Admin login identifier and bcrypt password hash.
# Generate a hash with:
#   python -c 'import bcrypt; print(bcrypt.hashpw(b"change-me", bcrypt.gensalt()).decode())'
ADMIN_IDENTIFIER=admin
ADMIN_PASSWORD_HASH=

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 主模型（按需）：任意 OpenAI 兼容端点的 URL、API Key 和模型名，由 settings.py 的
# load_primary_model_settings() 读取。三项必须同时填写或同时留空；只填一部分会抛
# PrimaryModelConfigError。不需要调用大模型的项目留空即可。
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# Public frontend base URL for backend API calls.
# Optional: docker-compose.yml defaults to http://zata-codes-template-backend:8000.
API_BASE_URL=http://zata-codes-template-backend:8000

# Database backup / restore / S3 settings have moved to the `zata-ops` CLI
# (https://github.com/zata/zata-ops). Install it once with
# `uv tool install --force /path/to/zata-ops` and run `zata-ops db backup` on
# the schedule of your choice (systemd timer, cron, GitHub Actions, Dokploy
# scheduled job, etc.). See zata-ops/docs/guides/scheduling.md for examples.
